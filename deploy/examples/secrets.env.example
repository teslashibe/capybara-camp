# Copy outside the repository and replace every value before use
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
CAMP_RUNTIME_DB_PASSWORD=REPLACE_WITH_RANDOM_RUNTIME_PASSWORD
CAMP_MIGRATION_DB_PASSWORD=REPLACE_WITH_RANDOM_MIGRATION_PASSWORD
CAMP_DATABASE_URL=postgres://camp_runtime:REPLACE_WITH_URL_ENCODED_RUNTIME_PASSWORD@camp-postgres:5432/camp?sslmode=disable
CAMP_MIGRATION_DATABASE_URL=postgres://camp_migrator:REPLACE_WITH_URL_ENCODED_MIGRATION_PASSWORD@camp-postgres:5432/camp?sslmode=disable
CAMP_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CAMP_RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_KEY
# Optional while running shared history only; enable before connecting cloud accounts
# CAMP_PROVIDER_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
# Optional cloud runner controller, using a separate limited database role
# CAMP_CONTROLLER_DB_PASSWORD=REPLACE_WITH_RANDOM_CONTROLLER_PASSWORD
# CAMP_CONTROLLER_DATABASE_URL=postgres://camp_controller:REPLACE_WITH_URL_ENCODED_CONTROLLER_PASSWORD@camp-postgres:5432/camp?sslmode=disable
# Optional GitHub App integration; set all five together
# CAMP_GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_APP_CLIENT_ID
# CAMP_GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_APP_CLIENT_SECRET
# CAMP_GITHUB_APP_SLUG=REPLACE_WITH_GITHUB_APP_SLUG
# CAMP_GITHUB_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
# CAMP_GITHUB_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
