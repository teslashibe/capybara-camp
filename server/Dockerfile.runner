FROM --platform=$BUILDPLATFORM golang:1.26@sha256:672c944cfd07599b5f1bb179869270cdc94c6254e41db4d431259693cb286b82 AS build
ARG TARGETARCH
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/camp-runner ./cmd/camp-runner

FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git tini && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/camp/providers
COPY server/runner-image/package.json server/runner-image/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && \
    node node_modules/@anthropic-ai/claude-code/install.cjs && \
    ln -s /opt/camp/providers/node_modules/.bin/codex /usr/local/bin/codex && \
    ln -s /opt/camp/providers/node_modules/.bin/claude /usr/local/bin/claude && \
    codex --version && claude --version && npm cache clean --force
COPY --from=build /out/camp-runner /camp-runner
RUN groupadd --gid 10001 camp && useradd --uid 10001 --gid 10001 --create-home camp
USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["/usr/bin/tini", "--", "/camp-runner"]
